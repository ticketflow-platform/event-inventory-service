{
  "lsp": {
    "jdtls": {
      "settings": {
        "jdk_auto_download": true,
        "lsp_proxy_path": "C:/Users/pdegtyarev/IdeaProjects/ticketflow-platform/event-inventory-service/scripts/java-sort-proxy.cmd",
        "initialization_options": {
          "settings": {
            "java": {
              "completion": {
                "importOrder": [""]
              },
              "format": {
                "enabled": false
              },
              "sources": {
                "organizeImports": {
                  "starThreshold": 9999,
                  "staticStarThreshold": 9999
                }
              }
            }
          }
        }
      }
    }
  },
  "languages": {
    "Java": {
      "formatter": {
        "external": {
          "command": "powershell.exe",
          "arguments": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "scripts/format-java.ps1",
            "{buffer_path}"
          ]
        }
      },
      "tab_size": 4,
      "hard_tabs": false,
      "preferred_line_length": 120
    },
    "SQL": {
      "formatter": {
        "external": {
          "command": "cmd.exe",
          "arguments": ["/d", "/c", "sql-formatter.cmd", "--language", "postgresql"]
        }
      }
    }
  }
}
